<Window x:Class="GardenDiary.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GardenDiary.ViewModels"
        xmlns:conv="clr-namespace:GardenDiary.Converters"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        Title="Garden Diary" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Closed="Window_Closed">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <conv:StringToBrushConverter x:Key="StringToBrush"/>
        <DropShadowEffect x:Key="DropShadow" BlurRadius="8" ShadowDepth="2" Opacity="0.18"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
    <DockPanel>

        <!-- ===== Menu bar ===== -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Settings">
                <MenuItem Header="Set _Home Location…"
                          Command="{Binding SetHomeLocationCommand}"/>
                <Separator/>
                <MenuItem Header="Change _Data Folder…"
                          Command="{Binding ChangeDataFolderCommand}"
                          ToolTip="{Binding DataFolderPath}"/>
            </MenuItem>
            <MenuItem Header="_Backup">
                <MenuItem Header="Backup _Now"
                          Command="{Binding BackupNowCommand}"
                          InputGestureText="Ctrl+B"/>
                <MenuItem Header="_Configure Backup Folder…"
                          Command="{Binding ConfigureBackupCommand}"/>
                <Separator/>
                <MenuItem Header="_Restore Backup…"
                          Command="{Binding RestoreBackupCommand}"/>
            </MenuItem>
        </Menu>

        <!-- ===== Status bar ===== -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" Foreground="#444"/>
            </StatusBarItem>
        </StatusBar>

        <!-- ===== Tabs ===== -->
        <TabControl x:Name="MainTabControl">

            <!-- ══════════════════════════════════════════════════
                 Tab 1: Calendar (default)
            ══════════════════════════════════════════════════ -->
            <TabItem Header="  Calendar  ">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Calendar control -->
                    <Border Grid.Column="0" Margin="16" VerticalAlignment="Top">
                        <StackPanel>
                            <Calendar x:Name="Cal"
                                      SelectionMode="SingleDate"
                                      IsTodayHighlighted="True"
                                      Loaded="Cal_Loaded"
                                      SelectedDatesChanged="Cal_SelectedDatesChanged"
                                      DisplayDateChanged="Cal_DisplayDateChanged"/>
                            <Button Content="Today" HorizontalAlignment="Center"
                                    Margin="0,6,0,0" Padding="20,3"
                                    Click="TodayBtn_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Splitter -->
                    <GridSplitter Grid.Column="1" Width="5"
                                  HorizontalAlignment="Stretch" Background="#DDD"/>

                    <!-- Day task panel -->
                    <DockPanel Grid.Column="2" Margin="16">

                        <!-- Header: date title + Add Activity + Add Lawn Activity buttons -->
                        <Border DockPanel.Dock="Top" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding DayTasksTitle}"
                                           FontSize="15" FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="+ Add Activity"
                                        Command="{Binding CalendarAddEntryCommand}"
                                        Padding="8,3"/>
                                <Button Grid.Column="2" Content="+ Add Lawn Activity"
                                        Command="{Binding CalendarAddAreaEntryCommand}"
                                        Padding="8,3" Margin="8,0,0,0"/>
                            </Grid>
                        </Border>

                        <!-- Weather panel -->
                        <Border DockPanel.Dock="Top" Margin="0,0,0,10"
                                Background="#EBF5FB" CornerRadius="4" Padding="10,7">
                            <Grid>
                                <!-- No home location -->
                                <TextBlock FontSize="11" FontStyle="Italic" Foreground="#777"
                                           Text="Set home location in Settings → Set Home Location to view weather.">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowWeatherNoLocation}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Loading -->
                                <TextBlock FontSize="11" FontStyle="Italic" Foreground="#555"
                                           Text="Loading weather…">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowWeatherLoading}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Error -->
                                <TextBlock FontSize="11" Foreground="#C0392B"
                                           Text="{Binding WeatherErrorText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowWeatherError}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Weather data -->
                                <WrapPanel>
                                    <WrapPanel.Style>
                                        <Style TargetType="WrapPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasWeather}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </WrapPanel.Style>
                                    <TextBlock Text="{Binding WeatherCondition}" FontWeight="SemiBold" Margin="0,0,14,0"/>
                                    <TextBlock Text="Temp:" Foreground="#555" Margin="0,0,3,0"/>
                                    <TextBlock Text="{Binding WeatherTempRange}" Margin="0,0,14,0"/>
                                    <TextBlock Text="Wind:" Foreground="#555" Margin="0,0,3,0"/>
                                    <TextBlock Text="{Binding WeatherWind}" Margin="0,0,14,0"/>
                                    <TextBlock Text="Rain:" Foreground="#555" Margin="0,0,3,0"/>
                                    <TextBlock Text="{Binding WeatherPrecipitation}" Margin="0,0,14,0"/>
                                    <TextBlock Text="Sunrise:" Foreground="#555" Margin="0,0,3,0"/>
                                    <TextBlock Text="{Binding WeatherSunrise}" Margin="0,0,14,0"/>
                                    <TextBlock Text="Sunset:" Foreground="#555" Margin="0,0,3,0"/>
                                    <TextBlock Text="{Binding WeatherSunset}"/>
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <!-- Empty state -->
                        <TextBlock DockPanel.Dock="Top"
                                   Text="No activities recorded for this day."
                                   Foreground="#999" FontStyle="Italic" Margin="0,8,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NoDayContent}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Location preview panel — always visible to keep layout stable -->
                        <Border DockPanel.Dock="Bottom" Height="130"
                                BorderBrush="#DDD" BorderThickness="1" CornerRadius="3"
                                Margin="0,6,0,0">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Background="#F0F4F0" Padding="8,3">
                                    <TextBlock x:Name="DayPreviewLabel"
                                               Text="Hover a plant to preview its location"
                                               FontSize="11" Foreground="#AAA" FontStyle="Italic"/>
                                </Border>
                                <Canvas x:Name="DayPreviewCanvas" Background="#E8F5E9"
                                        SizeChanged="DayPreviewCanvas_SizeChanged"/>
                            </DockPanel>
                        </Border>

                        <!-- Task groups -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Lawn Activities section header (shown first) -->
                                <TextBlock Text="🌿 Lawn Activities" FontWeight="SemiBold" FontSize="12"
                                           Foreground="#388E3C" Margin="0,0,0,4">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NoDayAreaTasks}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Lawn activity rows (one per area) -->
                                <ItemsControl ItemsSource="{Binding DayAreaTasks}" Margin="0,0,0,8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,6" BorderBrush="#DDE8DC" BorderThickness="0,0,0,1" Padding="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock FontSize="13">
                                                            <Run Text="🌿  "/>
                                                            <Run Text="{Binding Name}" FontWeight="SemiBold"/>
                                                            <Run Text=": "/>
                                                            <Run Text="{Binding Activities}" Foreground="#388E3C"/>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Notes}" FontStyle="Italic" Foreground="#666"
                                                                   FontSize="11" TextWrapping="Wrap" Margin="22,2,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Notes}" Value="">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="Edit" Padding="6,2" VerticalAlignment="Center"
                                                            Command="{Binding DataContext.EditCalendarAreaEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding AreaId}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Plant activity groups -->
                                <ItemsControl ItemsSource="{Binding DayTasks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,14"
                                                    BorderBrush="#DDE8DC" BorderThickness="0,0,0,1"
                                                    Padding="0,0,0,10">
                                                <StackPanel>

                                                    <!-- Activity badge + Edit button -->
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0"
                                                                Background="{Binding BadgeBackground, Converter={StaticResource StringToBrush}}"
                                                                CornerRadius="4" Padding="8,3"
                                                                HorizontalAlignment="Left">
                                                            <TextBlock Text="{Binding ActivityName}"
                                                                       FontWeight="Bold" FontSize="13"
                                                                       Foreground="{Binding BadgeForeground, Converter={StaticResource StringToBrush}}"/>
                                                        </Border>
                                                        <Button Grid.Column="1" Content="Edit"
                                                                Padding="6,2" VerticalAlignment="Center"
                                                                Command="{Binding DataContext.EditCalendarEntryCommand,
                                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding ActivityName}"/>
                                                    </Grid>

                                                    <!-- Plant list with location, latin name, notes -->
                                                    <ItemsControl ItemsSource="{Binding Plants}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Margin="10,3,0,6"
                                                                            Background="Transparent"
                                                                            Tag="{Binding PlantId}"
                                                                            MouseEnter="PlantRow_MouseEnter"
                                                                            MouseLeave="PlantRow_MouseLeave">
                                                                    <!-- Name row (CommonName + latin/variety inline) -->
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <TextBlock Text="•  " Foreground="#888" FontSize="13"/>
                                                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"/>
                                                                    </StackPanel>
                                                                    <!-- Location -->
                                                                    <TextBlock Text="{Binding LocationLabel}"
                                                                               Foreground="#4CAF50" FontSize="10"
                                                                               Margin="14,1,0,0">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding LocationAreaName}" Value="">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <!-- Notes -->
                                                                    <TextBlock Text="{Binding Notes}"
                                                                               FontStyle="Italic" Foreground="#666"
                                                                               FontSize="11" TextWrapping="Wrap"
                                                                               Margin="14,2,0,0">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Notes}" Value="">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ══════════════════════════════════════════════════
                 Tab 2: Tasks & Reminders
            ══════════════════════════════════════════════════ -->
            <TabItem Header="  Tasks &amp; Reminders  ">
                <DockPanel Margin="16">

                    <!-- Header row -->
                    <Border DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Tasks" FontSize="15" FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Show Completed"
                                    Command="{Binding ToggleCompletedCommand}"
                                    Padding="8,3" Margin="0,0,8,0"/>
                            <Button Grid.Column="2" Content="+ Add Task"
                                    Command="{Binding AddTaskCommand}"
                                    Padding="8,3"/>
                        </Grid>
                    </Border>

                    <!-- Empty state for active tasks -->
                    <TextBlock DockPanel.Dock="Top"
                               Text="No active tasks. Click '+ Add Task' to create one."
                               Foreground="#999" FontStyle="Italic" Margin="0,0,0,8"
                               Visibility="{Binding HasNoActiveTasks, Converter={StaticResource BoolToVis}}"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>

                            <!-- ── Task Cards ── -->
                            <ItemsControl ItemsSource="{Binding TaskCards}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,10" Padding="0,0,0,10"
                                                BorderBrush="#DDE8DC" BorderThickness="0,0,0,1">
                                            <StackPanel>

                                                <!-- Overdue banner -->
                                                <Border Background="#FFEBEE" Padding="8,4" Margin="0,0,0,6"
                                                        CornerRadius="3"
                                                        Visibility="{Binding IsOverdue, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding OverdueBadge}"
                                                               Foreground="#C62828" FontSize="11" FontWeight="SemiBold"/>
                                                </Border>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Left: task info -->
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontSize="14" FontWeight="Bold"/>
                                                        <TextBlock Text="{Binding ReminderDateLabel}"
                                                                   Foreground="#555" FontSize="11" Margin="0,2,0,0"/>

                                                        <!-- Type badge + activities -->
                                                        <WrapPanel Margin="0,4,0,4">
                                                            <Border Background="#E8F5E9" CornerRadius="3" Padding="6,2">
                                                                <TextBlock Text="{Binding TaskTypeLabel}"
                                                                           Foreground="#2E7D32" FontSize="11" FontWeight="SemiBold"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding RequiredActivitiesLabel}"
                                                                       Foreground="#777" FontSize="11"
                                                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                        </WrapPanel>

                                                        <!-- Done items -->
                                                        <StackPanel Margin="0,2,0,2"
                                                                    Visibility="{Binding HasDoneItems, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="Done:" Foreground="#2E7D32"
                                                                       FontSize="11" FontWeight="SemiBold"/>
                                                            <ItemsControl ItemsSource="{Binding DoneItems}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Foreground="#2E7D32" FontSize="11"
                                                                                   Margin="8,1,0,0">
                                                                            <Run Text="✓ "/><Run Text="{Binding Mode=OneWay}"/>
                                                                        </TextBlock>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>

                                                        <!-- Pending items (collapsed by default) -->
                                                        <Expander Margin="0,2,0,2" IsExpanded="False"
                                                                  Visibility="{Binding HasPendingItems, Converter={StaticResource BoolToVis}}">
                                                            <Expander.Header>
                                                                <TextBlock Foreground="#888" FontSize="11" FontWeight="SemiBold">
                                                                    <Run Text="Pending ("/><Run Text="{Binding PendingItems.Count, Mode=OneWay}"/><Run Text=")"/>
                                                                </TextBlock>
                                                            </Expander.Header>
                                                            <ItemsControl ItemsSource="{Binding PendingItems}" Margin="8,2,0,0">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Foreground="#888" FontSize="11"
                                                                                   Margin="0,1,0,0">
                                                                            <Run Text="• "/><Run Text="{Binding Mode=OneWay}"/>
                                                                        </TextBlock>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Expander>

                                                        <!-- Completed label -->
                                                        <TextBlock Text="{Binding CompletedDateLabel}"
                                                                   Foreground="#388E3C" FontSize="11" Margin="0,2,0,0"
                                                                   Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}"/>
                                                    </StackPanel>

                                                    <!-- Right: Edit / Skip / Delete buttons -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="8,0,0,0">
                                                        <Button Content="Edit" Padding="6,2" Margin="0,0,0,4"
                                                                Command="{Binding DataContext.EditTaskCommand,
                                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding Task}"/>
                                                        <Button Content="Skip" Padding="6,2" Margin="0,0,0,4"
                                                                Command="{Binding DataContext.SkipTaskCommand,
                                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding Task}">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <Button Content="Delete" Padding="6,2"
                                                                Command="{Binding DataContext.DeleteTaskCommand,
                                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding Task}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- ── Completed Tasks (collapsed by default) ── -->
                            <Expander Margin="0,8,0,4" IsExpanded="False">
                                <Expander.Style>
                                    <Style TargetType="Expander">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowCompletedTasks}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Expander.Style>
                                <Expander.Header>
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#666">
                                        <Run Text="Completed ("/>
                                        <Run Text="{Binding CompletedTaskCount, Mode=OneWay}"/>
                                        <Run Text=")"/>
                                    </TextBlock>
                                </Expander.Header>
                                <ItemsControl ItemsSource="{Binding CompletedTaskCards}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,10" Padding="0,0,0,10"
                                                    BorderBrush="#DDE8DC" BorderThickness="0,0,0,1"
                                                    Opacity="0.7">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding Title}"
                                                                       FontSize="13" FontWeight="Bold"/>
                                                            <TextBlock Text="{Binding ReminderDateLabel}"
                                                                       Foreground="#555" FontSize="11" Margin="0,1,0,0"/>
                                                            <TextBlock Text="{Binding CompletedDateLabel}"
                                                                       Foreground="#388E3C" FontSize="11" Margin="0,1,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="8,0,0,0">
                                                            <Button Content="Delete" Padding="6,2"
                                                                    Command="{Binding DataContext.DeleteTaskCommand,
                                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding Task}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>

                            <!-- ── Reminders section ── -->
                            <Separator Margin="0,8,0,12"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Latest Activities" FontSize="14" FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Width="180" Padding="6,3"
                                         Text="{Binding ReminderSearchText, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Background">
                                                        <Setter.Value>
                                                            <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                                <VisualBrush.Visual>
                                                                    <TextBlock Text="🔍 Search…" Foreground="#AAA"
                                                                               Margin="6,0,0,0" FontStyle="Italic"/>
                                                                </VisualBrush.Visual>
                                                            </VisualBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </Grid>

                            <!-- Lawn areas section (top) -->
                            <TextBlock Text="Lawn Areas" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#555" Margin="0,0,0,4"/>
                            <TextBlock Text="No lawn area diary entries recorded yet."
                                       Foreground="#999" FontStyle="Italic" Margin="0,0,0,8">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AreaReminders.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding AreaReminders}" Margin="0,0,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" BorderBrush="#DDD" BorderThickness="1"
                                                CornerRadius="3" Padding="8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding AreaName}"
                                                           FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
                                                <ItemsControl ItemsSource="{Binding Items}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,2,0,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="100"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0"
                                                                        Background="{Binding BadgeBackground, Converter={StaticResource StringToBrush}}"
                                                                        CornerRadius="3" Padding="6,2" HorizontalAlignment="Left">
                                                                    <TextBlock Text="{Binding ActivityName}"
                                                                               Foreground="{Binding BadgeForeground, Converter={StaticResource StringToBrush}}"
                                                                               FontSize="11" FontWeight="SemiBold"/>
                                                                </Border>
                                                                <TextBlock Grid.Column="1" Text="{Binding LastDateLabel}"
                                                                           FontSize="11" VerticalAlignment="Center"
                                                                           Margin="8,0,0,0"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding DaysAgoLabel}"
                                                                           Foreground="#888" FontSize="11"
                                                                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Plants section — grouped by garden area -->
                            <TextBlock Text="Plants" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#555" Margin="0,0,0,4"/>
                            <TextBlock Text="No plant diary entries recorded yet."
                                       Foreground="#999" FontStyle="Italic" Margin="0,0,0,8">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PlantAreaGroups.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding PlantAreaGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Expander IsExpanded="{Binding IsExpanded}" Margin="0,0,0,6">
                                            <Expander.Header>
                                                <TextBlock Text="{Binding AreaName}"
                                                           FontSize="12" FontWeight="SemiBold" Foreground="#444"/>
                                            </Expander.Header>
                                            <ItemsControl ItemsSource="{Binding Plants}" Margin="0,4,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,0,6" BorderBrush="#DDD" BorderThickness="1"
                                                                CornerRadius="3" Padding="8" Background="Transparent"
                                                                Tag="{Binding PlantId}"
                                                                MouseEnter="ActivityCard_MouseEnter"
                                                                MouseLeave="ActivityCard_MouseLeave">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding PlantDisplayName}"
                                                                           FontWeight="Bold" FontSize="13" Margin="0,0,0,1"/>
                                                                <TextBlock Text="{Binding LatinName}"
                                                                           FontStyle="Italic" Foreground="#888" FontSize="11" Margin="0,0,0,4">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding HasLatinName}" Value="False">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <ItemsControl ItemsSource="{Binding Items}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Grid Margin="0,2,0,2">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="100"/>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <Border Grid.Column="0"
                                                                                        Background="{Binding BadgeBackground, Converter={StaticResource StringToBrush}}"
                                                                                        CornerRadius="3" Padding="6,2" HorizontalAlignment="Left">
                                                                                    <TextBlock Text="{Binding ActivityName}"
                                                                                               Foreground="{Binding BadgeForeground, Converter={StaticResource StringToBrush}}"
                                                                                               FontSize="11" FontWeight="SemiBold"/>
                                                                                </Border>
                                                                                <TextBlock Grid.Column="1" Text="{Binding LastDateLabel}"
                                                                                           FontSize="11" VerticalAlignment="Center"
                                                                                           Margin="8,0,0,0"/>
                                                                                <TextBlock Grid.Column="2" Text="{Binding DaysAgoLabel}"
                                                                                           Foreground="#888" FontSize="11"
                                                                                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>


                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- ══════════════════════════════════════════════════
                 Tab 3: Plants & Diary
            ══════════════════════════════════════════════════ -->
            <TabItem x:Name="PlantsTab" Header="  Plants &amp; Diary  " Height="22" Margin="-2,0,-2,0" VerticalAlignment="Bottom">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270" MinWidth="180"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: Plants panel -->
                    <DockPanel Grid.Column="0" Margin="10">

                        <Border DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="My Plants"
                                           FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="+ Add Plant"
                                        Command="{Binding AddPlantCommand}" Padding="8,3"/>
                            </Grid>
                        </Border>

                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                    HorizontalAlignment="Right" Margin="0,6,0,0">
                            <Button Content="Edit"      Command="{Binding EditPlantCommand}"
                                    Width="68" Margin="0,0,6,0"/>
                            <Button Content="Duplicate" Command="{Binding DuplicatePlantCommand}"
                                    Width="72" Margin="0,0,6,0"/>
                            <Button Content="Delete"    Command="{Binding DeletePlantCommand}" Width="68"/>
                        </StackPanel>

                        <!-- Filter dropdown -->
                        <ComboBox DockPanel.Dock="Top" Margin="0,0,0,6"
                                  ItemsSource="{Binding PlantFilterItems}"
                                  SelectedItem="{Binding SelectedPlantFilter}"
                                  DisplayMemberPath="Label"/>

                        <!-- Search box -->
                        <TextBox DockPanel.Dock="Top" Margin="0,0,0,6" Padding="6,4"
                                 Text="{Binding PlantSearchText, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                        <VisualBrush.Visual>
                                                            <TextBlock Text="🔍 Search by name, latin name, variety…"
                                                                       Foreground="#AAA" Margin="6,0,0,0" FontStyle="Italic"/>
                                                        </VisualBrush.Visual>
                                                    </VisualBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <!-- Plant location preview -->
                        <Border DockPanel.Dock="Bottom" Margin="0,6,0,0"
                                BorderBrush="#CCC" BorderThickness="1" CornerRadius="3"
                                Height="160" ClipToBounds="True">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPlantHasLocation}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Background="#F0F4F0" Padding="8,4">
                                    <TextBlock Text="{Binding SelectedPlantLocationLabel}"
                                               FontSize="11" FontWeight="SemiBold" Foreground="#444"/>
                                </Border>
                                <Canvas x:Name="PlantLocationCanvas" Background="#E8F5E9"
                                        SizeChanged="PlantLocationCanvas_SizeChanged"/>
                            </DockPanel>
                        </Border>

                        <ListBox ItemsSource="{Binding FilteredPlants}"
                                 SelectedItem="{Binding SelectedPlant}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 MouseDoubleClick="PlantList_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="2,4">
                                        <emoji:TextBlock Text="{Binding Emoji}" FontSize="18"
                                                   VerticalAlignment="Center" Margin="0,0,6,0">
                                            <emoji:TextBlock.Style>
                                                <Style TargetType="emoji:TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Emoji}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </emoji:TextBlock.Style>
                                        </emoji:TextBlock>
                                        <StackPanel>
                                            <TextBlock Text="{Binding CommonName}"
                                                       FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="{Binding LatinName}"
                                                       FontStyle="Italic" Foreground="#666" FontSize="11"/>
                                            <TextBlock Text="{Binding Variety}"
                                                       Foreground="#888" FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!-- Splitter -->
                    <GridSplitter Grid.Column="1" Width="5"
                                  HorizontalAlignment="Stretch" Background="#DDD"/>

                    <!-- RIGHT: Diary entries panel -->
                    <DockPanel Grid.Column="2" Margin="10">

                        <Border DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding SelectedPlantTitle}"
                                           FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="+ Add Entry"
                                        Command="{Binding AddEntryCommand}" Padding="8,3"/>
                            </Grid>
                        </Border>

                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                    HorizontalAlignment="Right" Margin="0,6,0,0">
                            <Button Content="Edit"   Command="{Binding EditEntryCommand}"
                                    Width="68" Margin="0,0,6,0"/>
                            <Button Content="Delete" Command="{Binding DeleteEntryCommand}" Width="68"/>
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding Entries}"
                                  SelectedItem="{Binding SelectedEntry}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  GridLinesVisibility="Horizontal"
                                  AlternatingRowBackground="#F5F9F5"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date"
                                                    Binding="{Binding Date, StringFormat=yyyy-MM-dd}"
                                                    Width="95"/>
                                <DataGridCheckBoxColumn Header="Planting"    Binding="{Binding Planting}"    Width="72"/>
                                <DataGridCheckBoxColumn Header="Watering"    Binding="{Binding Watering}"    Width="72"/>
                                <DataGridCheckBoxColumn Header="Fertilizing" Binding="{Binding Fertilizing}" Width="80"/>
                                <DataGridCheckBoxColumn Header="Weeding"     Binding="{Binding Weeding}"     Width="72"/>
                                <DataGridCheckBoxColumn Header="Mulching"    Binding="{Binding Mulching}"    Width="72"/>
                                <DataGridCheckBoxColumn Header="Pruning"     Binding="{Binding Pruning}"     Width="68"/>
                                <DataGridTextColumn Header="Notes"           Binding="{Binding Notes}"       Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ══════════════════════════════════════════════════
                 Tab 3: Garden Planner
            ══════════════════════════════════════════════════ -->
            <TabItem Header="  Garden Planner  ">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210" MinWidth="160"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: Areas list -->
                    <DockPanel Grid.Column="0" Margin="10">

                        <Border DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Garden Areas"
                                           FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="+ Add"
                                        Command="{Binding AddAreaCommand}" Padding="8,3"/>
                            </Grid>
                        </Border>

                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                    HorizontalAlignment="Right" Margin="0,6,0,0">
                            <Button Content="Edit"   Command="{Binding EditAreaCommand}"
                                    Width="68" Margin="0,0,6,0"/>
                            <Button Content="Delete" Command="{Binding DeleteAreaCommand}" Width="68"/>
                        </StackPanel>

                        <ListBox ItemsSource="{Binding Areas}"
                                 SelectedItem="{Binding SelectedArea}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,4">
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock FontSize="11" Foreground="#888">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} × {1} cm">
                                                    <Binding Path="Width"/>
                                                    <Binding Path="Height"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!-- Splitter -->
                    <GridSplitter Grid.Column="1" Width="5"
                                  HorizontalAlignment="Stretch" Background="#DDD"/>

                    <!-- RIGHT: Canvas panel (or grey placeholder) -->
                    <Grid Grid.Column="2">

                    <!-- Placeholder shown when no area is selected -->
                    <Border Background="#E0E0E0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedArea}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="Select or create a garden area to begin planning."
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#888" FontStyle="Italic" FontSize="14"/>
                    </Border>

                    <DockPanel Margin="10">
                        <DockPanel.Style>
                            <Style TargetType="DockPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedArea}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DockPanel.Style>

                        <!-- Toolbar: plant picker + radius -->
                        <Border DockPanel.Dock="Top" Margin="0,0,0,6" Padding="4,4">
                            <WrapPanel>
                                <TextBlock Text="Place plant:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox ItemsSource="{Binding UnplacedPlantOptions}"
                                          SelectedItem="{Binding SelectedPlantOption}"
                                          Width="155" Margin="0,0,10,0">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Plant.CommonName}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="Default radius (cm):" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox Text="{Binding DefaultPlacementRadius, UpdateSourceTrigger=LostFocus}"
                                         Width="46" Margin="0,0,10,0" Padding="3,2" VerticalContentAlignment="Center"/>
                                <TextBlock Text="— click canvas to place, drag circle to move"
                                           VerticalAlignment="Center" Foreground="#999" FontStyle="Italic" FontSize="11"/>
                                <Separator Width="1" Height="20" Margin="10,0"/>
                                <TextBlock Text="Zoom:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Button Content="−" Width="24" Margin="0,0,2,0" Click="ZoomOut_Click"
                                        ToolTip="Zoom out"/>
                                <TextBlock x:Name="ZoomLabel" Text="100%" Width="38"
                                           TextAlignment="Center" VerticalAlignment="Center"/>
                                <Button Content="+" Width="24" Margin="2,0,2,0" Click="ZoomIn_Click"
                                        ToolTip="Zoom in"/>
                                <Button Content="↺" Width="28" Margin="2,0,0,0" Click="ZoomReset_Click"
                                        ToolTip="Reset zoom and scroll position"/>
                                <Separator Width="1" Height="20" Margin="10,0"/>
                                <TextBlock Text="Shapes:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Button Content="▭ Rect" Padding="6,2" Margin="0,0,4,0"
                                        Command="{Binding AddRectangleCommand}" ToolTip="Add rectangle shape"/>
                                <Button Content="○ Circle" Padding="6,2"
                                        Command="{Binding AddCircleCommand}" ToolTip="Add circle shape"/>
                            </WrapPanel>
                        </Border>

                        <!-- Mouse interaction help strip -->
                        <Border DockPanel.Dock="Top" Margin="0,0,0,4" Padding="8,5"
                                Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="0,1,0,1">
                            <WrapPanel>
                                <TextBlock Text="Controls:" FontWeight="SemiBold" FontSize="11"
                                           Foreground="#555" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                <!-- helper macro: each entry is [kbd chip] description -->
                                <Border Background="#E8E8E8" CornerRadius="3" Padding="5,1" Margin="0,0,4,2">
                                    <TextBlock Text="Left-click  canvas" FontSize="10" Foreground="#333"/>
                                </Border>
                                <TextBlock Text="Place plant" FontSize="11" Foreground="#555" Margin="0,0,14,2"
                                           VerticalAlignment="Center"/>

                                <Border Background="#E8E8E8" CornerRadius="3" Padding="5,1" Margin="0,0,4,2">
                                    <TextBlock Text="Left-click  circle" FontSize="10" Foreground="#333"/>
                                </Border>
                                <TextBlock Text="Select" FontSize="11" Foreground="#555" Margin="0,0,14,2"
                                           VerticalAlignment="Center"/>

                                <Border Background="#E8E8E8" CornerRadius="3" Padding="5,1" Margin="0,0,4,2">
                                    <TextBlock Text="Drag  circle" FontSize="10" Foreground="#333"/>
                                </Border>
                                <TextBlock Text="Move plant" FontSize="11" Foreground="#555" Margin="0,0,14,2"
                                           VerticalAlignment="Center"/>

                                <Border Background="#E8E8E8" CornerRadius="3" Padding="5,1" Margin="0,0,4,2">
                                    <TextBlock Text="Double-click  circle" FontSize="10" Foreground="#333"/>
                                </Border>
                                <TextBlock Text="Go to plant" FontSize="11" Foreground="#555" Margin="0,0,14,2"
                                           VerticalAlignment="Center"/>

                                <Border Background="#E8E8E8" CornerRadius="3" Padding="5,1" Margin="0,0,4,2">
                                    <TextBlock Text="Middle-drag" FontSize="10" Foreground="#333"/>
                                </Border>
                                <TextBlock Text="Pan" FontSize="11" Foreground="#555" Margin="0,0,14,2"
                                           VerticalAlignment="Center"/>

                                <Border Background="#E8E8E8" CornerRadius="3" Padding="5,1" Margin="0,0,4,2">
                                    <TextBlock Text="Scroll wheel" FontSize="10" Foreground="#333"/>
                                </Border>
                                <TextBlock Text="Zoom  (0.1× – 10×)" FontSize="11" Foreground="#555" Margin="0,0,14,2"
                                           VerticalAlignment="Center"/>

                                <Border Background="#E8E8E8" CornerRadius="3" Padding="5,1" Margin="0,0,4,2">
                                    <TextBlock Text="Right-click  shape" FontSize="10" Foreground="#333"/>
                                </Border>
                                <TextBlock Text="Z-order menu" FontSize="11" Foreground="#555" Margin="0,0,0,2"
                                           VerticalAlignment="Center"/>
                            </WrapPanel>
                        </Border>

                        <!-- Selection bar (bottom) — plant placement -->
                        <!-- Fixed-height bottom bar — all three panels share the same space
                             so the canvas never shifts when selection changes. -->
                        <Grid DockPanel.Dock="Bottom" Height="36" Margin="0,6,0,0">

                            <!-- Plant placement bar -->
                            <Border Background="#F5F5F5" Padding="8,5">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSelectedPlacement}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding SelectedPlacementLabel}"
                                               VerticalAlignment="Center" Foreground="#555"/>
                                    <TextBlock Text="Radius (cm):"
                                               VerticalAlignment="Center" Margin="12,0,4,0"/>
                                    <TextBox x:Name="TxtPlacementRadius" Width="50" Padding="3,2"
                                             VerticalContentAlignment="Center"
                                             Text="{Binding SelectedPlacementRadius, UpdateSourceTrigger=LostFocus}"
                                             KeyDown="PlacementRadius_KeyDown"
                                             LostFocus="PlacementRadius_LostFocus"/>
                                    <Button Content="Remove"
                                            Command="{Binding DeletePlacementCommand}"
                                            Width="72" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Shape selection bar -->
                            <Border Background="#EDE7F6" Padding="8,5">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSelectedShape}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding SelectedShapeLabel}"
                                               VerticalAlignment="Center" Foreground="#555" Margin="0,0,10,0"/>
                                    <TextBlock Text="Label:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox Width="90" Padding="3,2" Margin="0,0,8,0"
                                             VerticalContentAlignment="Center"
                                             Text="{Binding SelectedShape.Label, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             LostFocus="ShapeField_LostFocus"
                                             KeyDown="ShapeField_KeyDown"/>
                                    <TextBlock Text="W:" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                    <TextBox Width="44" Padding="3,2" Margin="0,0,6,0"
                                             VerticalContentAlignment="Center"
                                             Text="{Binding SelectedShape.Width, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             LostFocus="ShapeField_LostFocus"
                                             KeyDown="ShapeField_KeyDown"/>
                                    <TextBlock Text="H:" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                    <TextBox Width="44" Padding="3,2" Margin="0,0,6,0"
                                             VerticalContentAlignment="Center"
                                             Text="{Binding SelectedShape.Height, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             LostFocus="ShapeField_LostFocus"
                                             KeyDown="ShapeField_KeyDown"/>
                                    <TextBlock Text="Color:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <Grid Margin="0,0,8,0">
                                        <Button x:Name="ShapeColorBtn" Width="32" Height="22"
                                                Padding="0" Click="ShapeColorBtn_Click"
                                                ToolTip="Choose colour">
                                            <Border x:Name="ShapeColorPreview" Width="24" Height="14"
                                                    CornerRadius="2" Background="#90CAF9"/>
                                        </Button>
                                        <Popup x:Name="ColorPickerPopup" StaysOpen="False"
                                               Placement="Bottom" PlacementTarget="{Binding ElementName=ShapeColorBtn}">
                                            <Border Background="White" BorderBrush="#CCC" BorderThickness="1"
                                                    Padding="6" Effect="{StaticResource DropShadow}">
                                                <StackPanel>
                                                    <WrapPanel x:Name="SwatchPanel" Width="168" Margin="0,0,0,6"/>
                                                    <Button Content="Custom colour…" Click="ShapeCustomColor_Click"
                                                            HorizontalAlignment="Stretch" Padding="4,3"/>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                    <Button Content="Bring to Front" Padding="6,2" Margin="0,0,4,0"
                                            Command="{Binding BringShapeToFrontCommand}"/>
                                    <Button Content="Send to Back" Padding="6,2" Margin="0,0,4,0"
                                            Command="{Binding SendShapeToBackCommand}"/>
                                    <Button Content="Remove" Padding="6,2"
                                            Command="{Binding DeleteShapeCommand}"/>
                                </StackPanel>
                            </Border>

                            <!-- Default info bar when nothing is selected -->
                            <Border Background="#F5F5F5" Padding="8,5">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSelectedPlacement}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasSelectedShape}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="Click a plant or shape on the canvas to select it"
                                           VerticalAlignment="Center" Foreground="#555"/>
                            </Border>

                        </Grid>

                        <!-- Canvas viewport -->
                        <ScrollViewer x:Name="GardenScrollViewer"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      Background="#BDBDBD"
                                      Padding="20"
                                      PreviewMouseWheel="GardenScrollViewer_PreviewMouseWheel"
                                      PreviewMouseDown="GardenScrollViewer_PreviewMouseDown"
                                      PreviewMouseMove="GardenScrollViewer_PreviewMouseMove"
                                      PreviewMouseUp="GardenScrollViewer_PreviewMouseUp">
                            <Canvas x:Name="GardenCanvas"
                                    Background="#E8F5E9"
                                    IsVisibleChanged="GardenCanvas_IsVisibleChanged"
                                    MouseLeftButtonDown="GardenCanvas_MouseLeftButtonDown"
                                    Cursor="Cross"/>
                        </ScrollViewer>
                    </DockPanel>
                    </Grid><!-- end right panel wrapper -->
                </Grid>
            </TabItem>

        </TabControl>

    </DockPanel>

    <!-- Latest Activities hover preview popup (Grid sibling — outside DockPanel to avoid layout interference) -->
    <Popup x:Name="ActivityPreviewPopup"
           Placement="Mouse"
           AllowsTransparency="True"
           StaysOpen="True"
           IsOpen="False">
        <Border Background="White" BorderBrush="#CCC" BorderThickness="1"
                CornerRadius="3" Width="240" Height="170"
                Effect="{StaticResource DropShadow}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#F0F4F0" Padding="8,4">
                    <TextBlock x:Name="ActivityPreviewLabel"
                               FontSize="11" FontWeight="SemiBold" Foreground="#444"/>
                </Border>
                <Canvas x:Name="ActivityPreviewCanvas" Background="#E8F5E9"
                        SizeChanged="ActivityPreviewCanvas_SizeChanged"/>
            </DockPanel>
        </Border>
    </Popup>

    <!-- Garden canvas plant info popup — shown on selection when fields are hidden -->
    <Popup x:Name="PlantInfoPopup"
           Placement="MousePoint"
           AllowsTransparency="True"
           StaysOpen="True"
           IsOpen="False">
        <Border Background="White" BorderBrush="#CCC" BorderThickness="1"
                CornerRadius="4" Padding="10,8"
                Effect="{StaticResource DropShadow}">
            <StackPanel>
                <TextBlock x:Name="PlantInfoName"
                           FontSize="13" FontWeight="SemiBold"/>
                <TextBlock x:Name="PlantInfoLatin"
                           FontSize="11" FontStyle="Italic" Foreground="#555" Margin="0,2,0,0"/>
                <TextBlock x:Name="PlantInfoVariety"
                           FontSize="11" Foreground="#777" Margin="0,1,0,0"/>
            </StackPanel>
        </Border>
    </Popup>

    </Grid>
</Window>
