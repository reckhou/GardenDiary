<Window x:Class="GardenDiary.Views.LocationPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Set Home Location" Height="560" Width="780"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Map -->
        <wv2:WebView2 x:Name="MapWebView" Grid.Row="0"/>

        <!-- Coordinate display -->
        <Border Grid.Row="1" Background="#F5F5F5" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CoordLabel" Grid.Column="0"
                           Text="Click on the map to set your home location."
                           VerticalAlignment="Center" Foreground="#555" FontSize="12"/>
                <!-- Manual fallback inputs (shown on map load failure) -->
                <StackPanel x:Name="ManualPanel" Grid.Column="0" Orientation="Horizontal"
                            Visibility="Collapsed">
                    <TextBlock Text="Latitude:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="TxtLat" Width="90" Margin="0,0,12,0" Padding="4,3"/>
                    <TextBlock Text="Longitude:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="TxtLon" Width="90" Padding="4,3"/>
                </StackPanel>
                <TextBlock Grid.Column="1" FontSize="11" Foreground="#888"
                           VerticalAlignment="Center" Margin="12,0,0,0"
                           Text="OpenStreetMap © contributors"/>
            </Grid>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="10,6,10,10">
            <Button x:Name="OkButton" Content="OK" Width="80" Margin="0,0,8,0"
                    Click="OkClick" IsDefault="True" IsEnabled="False"/>
            <Button Content="Cancel" Width="80" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
