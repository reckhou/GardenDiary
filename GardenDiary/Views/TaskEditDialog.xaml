<Window x:Class="GardenDiary.Views.TaskEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Task" Height="660" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Row 0: Title ────────────────────────────────────────────────── -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Content="Title:" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <TextBox Grid.Column="1" x:Name="TxtTitle" Padding="4,3" VerticalContentAlignment="Center"/>
        </Grid>

        <!-- ── Row 1: Reminder Date ─────────────────────────────────────────── -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Content="Due Date:" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <DatePicker Grid.Column="1" x:Name="DtpReminder" SelectedDateFormat="Long"/>
        </Grid>

        <!-- ── Row 2: Task Type radio ────────────────────────────────────────── -->
        <Border Grid.Row="2" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4"
                Padding="10,8" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Task Type" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                <WrapPanel>
                    <RadioButton x:Name="RbPlants" Content="Plants" IsChecked="True"
                                 Margin="0,0,18,0" Checked="TaskType_Changed"/>
                    <RadioButton x:Name="RbLawn" Content="Lawn Areas"
                                 Checked="TaskType_Changed"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ── Row 3: Activity checkboxes (toggled by task type) ────────────── -->
        <Border Grid.Row="3" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4"
                Padding="10,8" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Activities" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                <!-- Plant activities -->
                <WrapPanel x:Name="PnlPlantActivities">
                    <CheckBox x:Name="ChkWatering"    Content="Watering"                  Margin="0,0,14,4"/>
                    <CheckBox x:Name="ChkFertilizing" Content="Fertilizing &amp; Mulching" Margin="0,0,14,4"/>
                    <CheckBox x:Name="ChkPruning"     Content="Pruning"                   Margin="0,0,14,4"/>
                    <CheckBox x:Name="ChkPlanting"    Content="Planting"                  Margin="0,0,0,4"/>
                </WrapPanel>
                <!-- Lawn activities (hidden initially) -->
                <WrapPanel x:Name="PnlLawnActivities" Visibility="Collapsed">
                    <CheckBox x:Name="ChkMowing"      Content="Mowing"      Margin="0,0,14,4"/>
                    <CheckBox x:Name="ChkLawnWatering" Content="Watering"   Margin="0,0,14,4"/>
                    <CheckBox x:Name="ChkOverseeding" Content="Overseeding" Margin="0,0,14,4"/>
                    <CheckBox x:Name="ChkFeeding"     Content="Feeding"     Margin="0,0,14,4"/>
                    <CheckBox x:Name="ChkAerating"    Content="Aerating"    Margin="0,0,0,4"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ── Row 4: Plant selector (star height, scrollable) ──────────────── -->
        <!-- Plant selector panel -->
        <Grid Grid.Row="4" x:Name="PnlPlantSelector">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- Search row -->
            <Grid Grid.Row="0" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Plants" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="🔍 " VerticalAlignment="Center" Margin="0,0,2,0"/>
                    <TextBox x:Name="TxtSearch" Width="150" Padding="4,2"
                             VerticalContentAlignment="Center"
                             TextChanged="TxtSearch_TextChanged"
                             Tag="Search plants…">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="Search plants…" Foreground="#AAA"
                                                                   Margin="5,0,0,0" FontStyle="Italic"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <Button Content="Select All" Padding="6,2" Margin="6,0,0,0" Click="SelectAll_Click"/>
                    <Button Content="Clear" Padding="6,2" Margin="4,0,0,0" Click="ClearAll_Click"/>
                </StackPanel>
            </Grid>
            <!-- Grouped plant list -->
            <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1" CornerRadius="3">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="PlantGroupList" Margin="4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4,0,0">
                                    <TextBlock Text="{Binding GroupName}"
                                               FontWeight="SemiBold" FontSize="11"
                                               Foreground="#666" Background="#F5F5F5"
                                               Padding="6,3" Margin="0,0,0,2"/>
                                    <ItemsControl ItemsSource="{Binding Items}" HorizontalAlignment="Stretch">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                          Margin="10,2,4,2"
                                                          HorizontalAlignment="Stretch"
                                                          HorizontalContentAlignment="Stretch"
                                                          Background="Transparent"
                                                          MouseEnter="PlantItem_MouseEnter"
                                                          MouseLeave="PlantItem_MouseLeave">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Plant.CommonName}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding LatinDisplay}"
                                                                   Foreground="#999" FontSize="11"
                                                                   FontStyle="Italic" Margin="6,1,0,0"
                                                                   Visibility="{Binding HasLatinDisplay}"/>
                                                    </StackPanel>
                                                </CheckBox>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Area selector panel (hidden initially) -->
        <Border Grid.Row="4" x:Name="PnlAreaSelector" Visibility="Collapsed"
                BorderBrush="#DDD" BorderThickness="1" CornerRadius="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="AreaCheckList" Margin="8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                      Margin="4,3,4,3">
                                <TextBlock Text="{Binding Area.Name}"/>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- ── Row 5: Repeat options ─────────────────────────────────────────── -->
        <Border Grid.Row="5" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4"
                Padding="10,8" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="Repeat" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                <WrapPanel>
                    <RadioButton x:Name="RbOneOff" Content="One-off" IsChecked="True"
                                 Margin="0,0,18,0"/>
                    <RadioButton x:Name="RbRepeat" Content="Repeat every"
                                 Margin="0,0,6,0"/>
                    <TextBox x:Name="TxtRepeatDays" Width="44" Padding="3,2"
                             VerticalContentAlignment="Center"
                             IsEnabled="{Binding IsChecked, ElementName=RbRepeat}"
                             Text="7"/>
                    <TextBlock Text=" days" VerticalAlignment="Center"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ── Row 6: OK / Cancel ────────────────────────────────────────────── -->
        <StackPanel Grid.Row="6" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="80" Margin="0,0,8,0" Click="OkClick" IsDefault="True"/>
            <Button Content="Cancel" Width="80" IsCancel="True"/>
        </StackPanel>

        <!-- Floating location preview popup -->
        <Popup x:Name="PlantPreviewPopup"
               Placement="Mouse"
               AllowsTransparency="True"
               StaysOpen="True"
               IsOpen="False">
            <Border Background="White" BorderBrush="#CCC" BorderThickness="1"
                    CornerRadius="3" Width="240" Height="170">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.18"/>
                </Border.Effect>
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#F0F4F0" Padding="8,4">
                        <TextBlock x:Name="PlantPreviewLabel"
                                   FontSize="11" FontWeight="SemiBold" Foreground="#444"/>
                    </Border>
                    <Canvas x:Name="PlantPreviewCanvas" Background="#E8F5E9"
                            SizeChanged="PlantPreviewCanvas_SizeChanged"/>
                </DockPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
