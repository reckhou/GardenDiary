<Window x:Class="GardenDiary.Views.EditAreaActivityDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Lawn Activity" Height="400" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Header -->
        <Border x:Name="HeaderBorder" Grid.Row="0" Margin="0,0,0,10" Padding="10,8" CornerRadius="4"
                BorderBrush="#DDD" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="TxtActivityName" FontSize="16" FontWeight="Bold"/>
                <TextBlock x:Name="TxtDate" FontSize="11" Opacity="0.8" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Row 1: Hint -->
        <TextBlock Grid.Row="1" FontSize="11" Foreground="#888" FontStyle="Italic"
                   Margin="0,0,0,6"
                   Text="Tick areas to add activity / untick to remove"/>

        <!-- Row 2: Area list -->
        <Border Grid.Row="2" BorderBrush="#DDD" BorderThickness="1" CornerRadius="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="AreaCheckList" Margin="4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                      Margin="6,3,4,3">
                                <TextBlock Text="{Binding Area.Name}" FontSize="13"/>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Row 3: Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Save" Width="80" Margin="0,0,8,0" Click="OkClick" IsDefault="True"/>
            <Button Content="Cancel" Width="80" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
