<Window x:Class="GardenDiary.Views.EditActivityDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Activity" Height="660" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Row 0: Date + activity header ─────────────────────────────── -->
        <Border x:Name="HeaderBorder" Grid.Row="0" Margin="0,0,0,10" Padding="10,8" CornerRadius="4"
                BorderBrush="#DDD" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="TxtActivityName" FontSize="14" FontWeight="Bold"
                           Foreground="{Binding BadgeForeground}"/>
                <TextBlock x:Name="TxtDate" FontSize="11" Foreground="#555" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- ── Row 1: Plants header + search ─────────────────────────────── -->
        <Grid Grid.Row="1" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Plants" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="🔍 " VerticalAlignment="Center" Margin="0,0,2,0"/>
                <TextBox x:Name="TxtSearch" Width="150" Padding="4,2"
                         VerticalContentAlignment="Center"
                         TextChanged="TxtSearch_TextChanged">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                <VisualBrush.Visual>
                                                    <TextBlock Text="Search plants…" Foreground="#AAA"
                                                               Margin="5,0,0,0" FontStyle="Italic"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <Button Content="Select All" Padding="6,2" Margin="6,0,0,0" Click="SelectAll_Click"/>
                <Button Content="Clear" Padding="6,2" Margin="4,0,0,0" Click="ClearAll_Click"/>
            </StackPanel>
        </Grid>

        <!-- ── Row 2: Note ───────────────────────────────────────────────── -->
        <TextBlock Grid.Row="2" FontSize="11" Foreground="#888" FontStyle="Italic"
                   Margin="0,0,0,6"
                   Text="Checked plants have this activity recorded. Uncheck to remove it."/>

        <!-- ── Row 3: Grouped plant list ─────────────────────────────────── -->
        <Border Grid.Row="3" BorderBrush="#DDD" BorderThickness="1" CornerRadius="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="PlantGroupList" Margin="4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4,0,0">
                                <TextBlock Text="{Binding GroupName}"
                                           FontWeight="SemiBold" FontSize="11"
                                           Foreground="#666" Background="#F5F5F5"
                                           Padding="6,3" Margin="0,0,0,2"/>
                                <ItemsControl ItemsSource="{Binding Items}" HorizontalAlignment="Stretch">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                      Margin="10,2,4,2"
                                                      HorizontalAlignment="Stretch"
                                                      HorizontalContentAlignment="Stretch"
                                                      Background="Transparent"
                                                      MouseEnter="PlantItem_MouseEnter">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Plant.CommonName}"
                                                               FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Plant.Variety}"
                                                               Foreground="#888" FontSize="11"
                                                               Margin="4,1,0,0"
                                                               Visibility="{Binding HasVariety}"/>
                                                    <TextBlock Text="{Binding Plant.LatinName}"
                                                               Foreground="#999" FontSize="11"
                                                               FontStyle="Italic" Margin="6,1,0,0"
                                                               Visibility="{Binding HasLatinName}"/>
                                                </StackPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- ── Row 4: Location preview ───────────────────────────────────── -->
        <Border x:Name="PreviewBorder" Grid.Row="4" BorderBrush="#DDD" BorderThickness="1"
                CornerRadius="3" Margin="0,6,0,0" Height="130" Visibility="Collapsed">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#F0F4F0" Padding="8,3">
                    <TextBlock x:Name="PreviewLabel" Text="" FontSize="11" Foreground="#555"/>
                </Border>
                <Canvas x:Name="PreviewCanvas" Background="#E8F5E9"
                        SizeChanged="PreviewCanvas_SizeChanged"/>
            </DockPanel>
        </Border>

        <!-- ── Row 5: Buttons ────────────────────────────────────────────── -->
        <StackPanel Grid.Row="5" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Save" Width="80" Margin="0,0,8,0" Click="OkClick" IsDefault="True"/>
            <Button Content="Cancel" Width="80" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
