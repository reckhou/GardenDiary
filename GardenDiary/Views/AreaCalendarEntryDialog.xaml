<Window x:Class="GardenDiary.Views.AreaCalendarEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Log Lawn Activity" Height="520" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Header -->
        <Border Grid.Row="0" Background="#388E3C" Margin="-12,-12,-12,0" Padding="12,10">
            <TextBlock Text="Log Lawn Activity" Foreground="White"
                       FontSize="15" FontWeight="Bold"/>
        </Border>

        <!-- Row 1: Date -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Content="Date:" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <DatePicker Grid.Column="1" x:Name="DtpDate" SelectedDateFormat="Long"/>
        </Grid>

        <!-- Row 2: Activities -->
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="Activities:" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <WrapPanel>
                <CheckBox x:Name="ChkMowing"      Content="🌿 Mowing"      Margin="0,0,12,4"/>
                <CheckBox x:Name="ChkWatering"    Content="💧 Watering"    Margin="0,0,12,4"/>
                <CheckBox x:Name="ChkOverseeding" Content="🌱 Overseeding" Margin="0,0,12,4"/>
                <CheckBox x:Name="ChkFeeding"     Content="🧪 Feeding"     Margin="0,0,12,4"/>
                <CheckBox x:Name="ChkAerating"    Content="🔵 Aerating"    Margin="0,0,12,4"/>
            </WrapPanel>
        </StackPanel>

        <!-- Row 3: Areas -->
        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="Areas:" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="3">
                <ScrollViewer Height="140" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="AreaCheckList" Margin="4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                          Margin="4,2,4,2">
                                    <TextBlock Text="{Binding Area.Name}"/>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </StackPanel>

        <!-- Row 4: Notes -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Content="Notes:" VerticalAlignment="Top" FontWeight="SemiBold" Margin="0,2,0,0"/>
            <TextBox Grid.Column="1" x:Name="TxtNotes"
                     Height="50" Padding="4"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"/>
        </Grid>

        <!-- Row 5: Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="80" Margin="0,0,8,0" Click="OkClick" IsDefault="True"/>
            <Button Content="Cancel" Width="80" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
